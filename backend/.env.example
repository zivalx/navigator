# Database
DATABASE_URL=postgresql://user:password@localhost:5432/navigator

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys - Market Data
POLYGON_API_KEY=your_polygon_key_here
FINNHUB_API_KEY=your_finnhub_key_here
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# API Keys - News
MARKETAUX_API_KEY=your_marketaux_key_here

# API Keys - Crypto
# CoinGecko doesn't require a key for basic usage

# API Keys - FX
EXCHANGERATE_API_KEY=your_exchangerate_key_here

# API Keys - AI
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# App Settings
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:7070,http://localhost:3000,http://localhost:3002

# Cache Settings
QUOTE_CACHE_TTL=60
NEWS_CACHE_TTL=900
FX_CACHE_TTL=3600
