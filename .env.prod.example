# Navigator Production Environment
# Copy this file to .env.prod and fill in real values

# App
APP_ENV=production
SECRET_KEY=generate-a-strong-random-key-here

# Domain
DOMAIN=navigator.yourdomain.com
CERTBOT_EMAIL=your@email.com

# Database
POSTGRES_USER=navigator
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=navigator
DATABASE_URL=postgresql://navigator:change-this-strong-password@postgres:5432/navigator

# Redis
REDIS_PASSWORD=change-this-strong-password
REDIS_URL=redis://:change-this-strong-password@redis:6379/0

# CORS
CORS_ORIGINS=https://navigator.yourdomain.com

# API Keys
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_KEY=
EXCHANGERATE_API_KEY=

# AI (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cache TTL (seconds)
QUOTE_CACHE_TTL=60
NEWS_CACHE_TTL=900
FX_CACHE_TTL=3600
